{
  "expo": {
    "name": "plantidexreal",
    "slug": "plantidexreal",
    "version": "1.0.0",
    "scheme": "plantidex",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plantidex.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Plantidex usa la cámara para fotografiar especies que registras.",
        "NSLocationWhenInUseUsageDescription": "Plantidex usa tu ubicación para geolocalizar las especies que reportas."
      }
    },
    "android": {
      "package": "com.plantidex.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1A12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_API_KEY_PLACEHOLDER"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Plantidex usa la cámara para fotografiar especies que registras."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Plantidex usa tu ubicación para geolocalizar las especies que reportas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Plantidex necesita acceso a tus fotos para adjuntar imágenes de especies."
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/"
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
